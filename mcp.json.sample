{
  "mcpServers": {
    "keenable": {
      "url": "https://api.keenable.ai/mcp",
      "headers": {
        "X-API-Key": "${KEENABLE_API_KEY}"
      }
    },
    "korean-law": {
      "url": "https://mcp.gomdori.app/law"
    },
    "sqlite": {
      "command": ".venv/Scripts/python.exe",
      "args": ["tools/sqlite_mcp_server.py", "--db-path", "chord.db"]
    }
  }
}
