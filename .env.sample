# ============================================================================
# chord - Discord LLM bot : sample environment file
#
# Copy this file to ".env" and fill in the real values.
#   PowerShell :  Copy-Item .env.sample .env
#
# The .env file is git-ignored, so secrets never reach the repository.
# Every value below also works as a normal environment variable.
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------------

# Discord bot token.
# Create a bot at https://discord.com/developers/applications
#   -> Bot -> Reset Token, then enable "Message Content Intent".
DISCORD_TOKEN=your-discord-bot-token-here

# API key for your LLM provider.
# ANY format works — just match it with OPENAI_BASE_URL below.
#
#   OpenAI:   sk-proj-...     base_url: https://api.openai.com/v1 (default)
#   Gemini:   AIzaSy...       base_url: https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter: sk-or-...     base_url: https://openrouter.ai/api/v1
#   Ollama:   ollama          base_url: http://localhost:11434/v1
#
# Example (Gemini):
#   OPENAI_API_KEY=AIzaSyYourGeminiKeyHere
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-api-key-here

# ----------------------------------------------------------------------------
# OPTIONAL - LLM settings
# ----------------------------------------------------------------------------

# Base URL of any OpenAI-compatible API.
#   OpenAI      : https://api.openai.com/v1          (default)
#   OpenRouter  : https://openrouter.ai/api/v1
#   Local LLM   : http://localhost:11434/v1           (Ollama example)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name understood by the provider above.
OPENAI_MODEL=gpt-4o-mini

# How hard the model may think before it answers.
#   auto   - send nothing; whatever the provider does by default
#   none   - answer immediately (default; best for chat)
#   light  - a little thinking on hard questions
#   medium - balanced
#   heavy  - think it through, noticeably slower
#
# Discord is a chat window, so the default is "none": a two-second
# greeting beats a twelve-second essay. Raise it if you mostly ask the
# bot hard analytical questions.
#
# Models with no notion of reasoning effort (gpt-4o-mini, most Gemma /
# local models) reject the parameter; the bot detects that on the first
# request, logs a warning and carries on without it, so this is always
# safe to set. Changeable at runtime with /reasoning.
REASONING_LEVEL=none

# Provider-side content filtering: default | off
#
# "off" only means something where the provider actually exposes a
# threshold. Today that is the Gemini API, where it sends every harm
# category at BLOCK_NONE; on any other base URL the bot logs a warning
# and sends nothing, because there is no such knob to turn.
#
# Read the label carefully: this turns off the *API's* probability-based
# filter. It does nothing about what the model itself was trained to
# decline, and nothing about persona.md - and between those two, that is
# where most surprising refusals actually come from. If the bot is
# declining harmless questions, edit the Boundaries section of
# persona.md first; this setting is for the case where the provider,
# not the character, is the one saying no.
LLM_SAFETY_FILTERS=default

# Raw JSON object merged into every request's extra_body, for provider
# extras chord has no setting of its own. Merged deeply, and it wins over
# whatever LLM_SAFETY_FILTERS produced. Invalid JSON fails at startup.
#   Gemini context caching:
#     LLM_EXTRA_BODY={"extra_body": {"google": {"cached_content": "..."}}}
LLM_EXTRA_BODY=

# Seconds to wait for one LLM response before giving up (must be > 0).
# The SDK's own default is 10 minutes, which in a chat window is
# indistinguishable from the bot ignoring you.
LLM_TIMEOUT_SECONDS=120

# ----------------------------------------------------------------------------
# OPTIONAL - conversation memory
# ----------------------------------------------------------------------------

# Estimated prompt tokens of stored channel history above which the
# oldest turns get folded into a short summary written by the model
# itself. Without this a busy channel eventually sends more prompt than
# the provider (or its per-minute input-token quota) accepts.
#
# Set it well below the model's context window: what has to fit is the
# NEXT turn — history plus the tool catalog plus the answer. On a free
# Gemini key (16k input tokens/minute) 6000 leaves room for both.
# 0 turns compaction off and leaves only the message cap below.
HISTORY_TOKEN_BUDGET=6000

# Hard cap on messages remembered per channel. The backstop for what
# compaction cannot help with — a single enormous turn — and what bounds
# memory when HISTORY_TOKEN_BUDGET=0. Whole turns are dropped, never
# half of one.
HISTORY_MAX_MESSAGES=40

# ----------------------------------------------------------------------------
# OPTIONAL - charts
# ----------------------------------------------------------------------------

# Font used for chart labels (get_price_history). Leave empty and the
# bot downloads Noto Sans KR once (4.6 MB, OFL) into FONT_CACHE_DIR and
# reuses it forever after - so charts look the same on every host and
# Korean labels work on a slim container with no fonts installed.
#
# Set this to use a font of your own instead; it skips the download
# entirely, which is also how you keep the bot off the network. Any
# .ttf/.otf/.ttc that covers Hangul works.
CHART_FONT_PATH=

# Where that downloaded font is cached. One file, fetched on the first
# chart. Delete the directory to force a re-download.
FONT_CACHE_DIR=.cache/fonts

# ----------------------------------------------------------------------------
# OPTIONAL - diagnostics
# ----------------------------------------------------------------------------

# DEBUG / INFO / WARNING / ERROR / CRITICAL (default INFO).
# DEBUG additionally logs why each message was answered — useful when the
# bot seems to ignore a mention. discord.py / httpx / mcp stay at INFO so
# their per-heartbeat chatter doesn't bury it.
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# OPTIONAL - MCP servers
# ----------------------------------------------------------------------------

# Path to the JSON file describing external MCP servers to connect to.
# See mcp.json.sample for the format.
MCP_CONFIG_PATH=mcp.json

# Set to "true" to skip loading MCP servers entirely.
MCP_ENABLED=true

# ----------------------------------------------------------------------------
# OPTIONAL - extra API keys
# Skills work without them via free key-less sources; keys unlock the
# preferred Korean/official providers.
# ----------------------------------------------------------------------------

# KMA (기상청 단기예보) service key for official Korean weather.
# https://www.data.go.kr/data/15084084/openapi
KMA_API_KEY=

# WeatherAPI.com key for worldwide weather.
# Free tier: https://www.weatherapi.com/signup.aspx
WEATHERAPI_API_KEY=

# OpenWeather key, alternative worldwide weather provider.
# Free tier: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# AirKorea (에어코리아) service key for Korean station air-quality data.
# https://www.data.go.kr/data/15073861/openapi
AIRKOREA_API_KEY=

# Aviationstack key for flight lookup (real-time flights).
# Free tier: https://aviationstack.com/signup/free
AVIATIONSTACK_API_KEY=

# SweetTracker (스마트택배) key for aggregated Korean parcel tracking.
# https://tracking.sweettracker.co.kr/ (free after registration)
SWEETTRACKER_API_KEY=

# lrl.kr URL shortener API key (UUID format, sent as x-api-key).
# Issue at https://api.lrl.kr after login.
LRL_API_KEY=

# Kakao REST API key for Korean maps, place search and navigation.
# https://developers.kakao.com/console/app
KAKAO_REST_API_KEY=

# 국립중앙도서관 open API key, for search_books. Issue one at
# https://www.nl.go.kr/NL/contents/N31101030700.do
# It is the first catalogue tried and the only one that reliably knows
# a Korean edition's publisher and year. Without it, book search falls
# through to Google Books and Open Library and still works.
NL_API_KEY=

# Google Books API key (optional). The API answers without one until
# the anonymous daily quota runs out - and that quota is per IP and
# shared with everyone else behind it, so in practice it 429s a lot.
# A key from console.cloud.google.com (Books API) makes it dependable.
GOOGLE_BOOKS_API_KEY=

# Keenable live-web-search API key (https://keenable.ai).
#
# Used directly by the web_search skill as its fallback engine: when
# DuckDuckGo serves a "confirm you are human" page - which it does to
# any burst of searches - the same query goes to Keenable instead.
# Without this key, a blocked search is simply a failed search.
#
# Also referenced from mcp.json as ${KEENABLE_API_KEY}, which exposes
# Keenable's own tools separately. That is now duplicative of web_search
# and costs tool-catalog tokens on every message; drop it from mcp.json
# unless you want its LLM-extraction fetch_page_content specifically.
KEENABLE_API_KEY=

# Cloudflare Radar URL Scanner (optional, for URL safety checks).
# Create a token at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
